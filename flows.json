        "name": "Separate Outputs",
        "func": "let temperature  = msg.payload.temperature  ?? 0;\nlet humidity     = msg.payload.humidity     ?? 0;\nlet water_level  = msg.payload.water_level  ?? \"Unknown\";\n\nlet tempMsg       = { payload: temperature, humidity: humidity };\nlet humidityMsg   = { payload: humidity };\nlet waterLevelMsg = { payload: String(water_level) };\n\nreturn [tempMsg, humidityMsg, waterLevelMsg];\n",
