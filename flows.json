    {
        "id": "188523fe43fcf186",
        "type": "function",
        "z": "f56a74b2f85b2819",
        "name": "Check Alerts",
        "func": "let alerts = [];\n\n// msg.payload contains temperature\nif (msg.payload > 30) {\n    alerts.push(`High Temperature: ${msg.payload}°C`);\n}\n\n// We passed humidity along in tempMsg earlier\nif (msg.humidity !== undefined && msg.humidity > 80) {\n    alerts.push(`High Humidity: ${msg.humidity}%`);\n}\n\nif (alerts.length > 0) {\n    msg.payload = alerts.join(\" | \");\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 1250,
