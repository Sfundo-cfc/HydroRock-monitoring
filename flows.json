    {
        "id": "d290b7225beb59f6",
        "type": "function",
        "z": "f56a74b2f85b2819",
        "name": "Burst for Temp Chart",
        "func": "// create a 2-point burst so the chart always draws a line\nconst prev = context.get(\"prev\") ?? msg.payload;   // if no prev, repeat current\ncontext.set(\"prev\", msg.payload);\n\n// send the previous value immediately ...\nnode.send({ payload: prev });\n\n// ... then the current value\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
